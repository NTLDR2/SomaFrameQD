<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <RootNamespace>SomaFrameQD.Modules.PropertyGrid</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PackageTags>core WPF MVVM AvalonDock Caliburn Micro Visual Studio IDE Shell PropertyGrid</PackageTags>
    <Description>PropertyGrid module for SomaFrameQD, utilising the PropertyGrid control from the Extended WPF Toolkit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SomaFrameQD\SomaFrameQD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\Properties.png" />
  </ItemGroup>
  
</Project>