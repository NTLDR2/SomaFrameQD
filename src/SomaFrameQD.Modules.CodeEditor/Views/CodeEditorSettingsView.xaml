<UserControl x:Class="SomaFrameQD.Modules.CodeEditor.Views.CodeEditorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:SomaFrameQD="http://schemas.timjones.io/SomaFrameQD"
             xmlns:viewModels="clr-namespace:SomaFrameQD.Modules.CodeEditor.ViewModels"
             xmlns:p="clr-namespace:SomaFrameQD.Modules.CodeEditor.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance viewModels:CodeEditorSettingsViewModel}"
             IsTabStop="False">
    <StackPanel>
        <CheckBox IsChecked="{Binding ShowLineNumbers}"
                  Margin="0,5,0,0"
                  Content="{SomaFrameQD:Translate p:Resources.ShowLineNumbersCommandText}"
                  ToolTip="{SomaFrameQD:Translate p:Resources.ShowLineNumbersCommandToolTip}"/>

        <CheckBox IsChecked="{Binding ShowSpaces}"
                  Margin="0,5,0,0"
                  Content="{SomaFrameQD:Translate p:Resources.ShowSpacesCommandText}"
                  ToolTip="{SomaFrameQD:Translate p:Resources.ShowSpacesCommandToolTip}"/>

        <CheckBox IsChecked="{Binding ShowTabs}"
                  Margin="0,5,0,0"
                  Content="{SomaFrameQD:Translate p:Resources.ShowTabsCommandText}"
                  ToolTip="{SomaFrameQD:Translate p:Resources.ShowTabsCommandToolTip}"/>

        <CheckBox IsChecked="{Binding ShowEndOfLine}"
                  Margin="0,5,0,0"
                  Content="{SomaFrameQD:Translate p:Resources.ShowEndOfLineCommandText}"
                  ToolTip="{SomaFrameQD:Translate p:Resources.ShowEndOfLineCommandToolTip}"/>

        <CheckBox IsChecked="{Binding WordWrap}"
                  Margin="0,5,0,0"
                  Content="{SomaFrameQD:Translate p:Resources.WordWrapCommandText}"
                  ToolTip="{SomaFrameQD:Translate p:Resources.WordWrapCommandToolTip}"/>
    </StackPanel>
</UserControl>
