<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <RootNamespace>SomaFrameQD.Demo</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.de.Designer.cs">
      <DependentUpon>Resources.de.resx</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.de.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.de.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.ko.resx" />
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.ru.resx" />
    <EmbeddedResource Update="Properties\Resources.zh-Hans.resx" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SomaFrameQD.Modules.CodeCompiler\SomaFrameQD.Modules.CodeCompiler.csproj" />
    <ProjectReference Include="..\SomaFrameQD.Modules.CodeEditor\SomaFrameQD.Modules.CodeEditor.csproj" />
    <ProjectReference Include="..\SomaFrameQD.Modules.ErrorList\SomaFrameQD.Modules.ErrorList.csproj" />
    <ProjectReference Include="..\SomaFrameQD.Modules.GraphEditor\SomaFrameQD.Modules.GraphEditor.csproj" />
    <ProjectReference Include="..\SomaFrameQD.Modules.Inspector\SomaFrameQD.Modules.Inspector.csproj" />
    <ProjectReference Include="..\SomaFrameQD.Modules.Output\SomaFrameQD.Modules.Output.csproj" />
    <ProjectReference Include="..\SomaFrameQD.Modules.PropertyGrid\SomaFrameQD.Modules.PropertyGrid.csproj" />
    <ProjectReference Include="..\SomaFrameQD\SomaFrameQD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Modules\FilterDesigner\Resources\*.png" />
    <HLSLShader Include="Modules\FilterDesigner\ShaderEffects\*.fx">
      <ShaderProfile>ps_2_0</ShaderProfile>
      <ObjectFileOutput>$(OutputPath)$([System.IO.Path]::ChangeExtension(%(HLSLShader.Identity), '.ps'))</ObjectFileOutput>
    </HLSLShader>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JeremyAnsel.HLSL.Targets" Version="1.0.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.5.109" />
  </ItemGroup>

</Project>
