<Project>
    <PropertyGroup>
        <Authors>Dmitriy Novikov, Tim Jones, and contributors</Authors>
        <Copyright>Copyright (c) Dmitriy Novikov, Tim Jones, and contributors</Copyright>
        <RepositoryUrl>https://github.com/NTLDR2/SomaFrameQD</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <LangVersion>12.0</LangVersion>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <PropertyGroup>
        <DebugType>portable</DebugType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System.ComponentModel.Composition" />
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.5.109" PrivateAssets="all" />
    </ItemGroup>
</Project>
